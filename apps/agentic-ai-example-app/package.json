{
  "name": "@apps/agentic-ai-example-app",
  "version": "0.0.0",
  "private": true,
  "description": "SvelteKit Agentic AI Example App",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build",
    "clean": "del .turbo coverage .svelte-kit build *.sarif",
    "codegen": "svelte-kit sync",
    "dev": "vite dev",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.94",
    "@ai-sdk/svelte": "5.0.141",
    "@packages/ui-lib-svelte": "workspace:*",
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/load-config": "0.2.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@toolchain/eslint": "workspace:*",
    "@toolchain/typescript": "workspace:*",
    "@toolchain/vitest": "workspace:*",
    "@types/node": "26.6.5",
    "ai": "7.0.141",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "svelte-sonner": "1.2.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "zod": "4.6.7"
  }
}
