{
  "name": "@apps/effect-api-server",
  "version": "0.0.0",
  "private": true,
  "description": "Effect Node API Server",
  "license": "UNLICENSED",
  "type": "module",
  "main": "build/index.js",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "del .turbo coverage build *.sarif",
    "dev": "node --watch --env-file=.env src/index.ts",
    "lint": "eslint ",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/opentelemetry": "catalog:effect4",
    "@effect/platform-node": "catalog:effect4",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@packages/api": "workspace:*",
    "@packages/api-impl": "workspace:*",
    "effect": "catalog:effect4"
  },
  "devDependencies": {
    "@toolchain/eslint-config": "workspace:*",
    "@toolchain/typescript-config": "workspace:*",
    "@toolchain/vite-config": "workspace:*",
    "@toolchain/vitest-config": "workspace:*"
  }
}
