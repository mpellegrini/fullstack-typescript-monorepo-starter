    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.4",
    "effect": "4.0.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.10.1",
    "@toolchain/eslint": "workspace:*",
    "@toolchain/typescript": "workspace:*",
    "@toolchain/vite": "workspace:*",
    "@toolchain/vitest": "workspace:*",
    "@types/node": "26.6.5"
  }
}
