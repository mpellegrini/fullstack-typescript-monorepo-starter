{
  "name": "@apps/effect-mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "Effect MCP Server Example App",
  "license": "UNLICENSED",
  "type": "module",
  "main": "build/index.js",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "del .turbo coverage build *.sarif",
