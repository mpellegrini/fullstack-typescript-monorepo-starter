{
  "name": "@apps/ha-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "SvelteKit Example App",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build",
    "clean": "del .turbo coverage .svelte-kit build *.sarif",
    "codegen": "svelte-kit sync",
    "dev": "vite dev",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@packages/ui-lib-svelte": "workspace:*",
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/load-config": "0.2.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@toolchain/eslint": "workspace:*",
    "@toolchain/typescript": "workspace:*",
    "@toolchain/vitest": "workspace:*",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "home-assistant-js-websocket": "9.8.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "vite": "8.3.7",
    "ws": "8.22.2"
  }
}
