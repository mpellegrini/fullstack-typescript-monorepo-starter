{
  "name": "@apps/sveltekit-example-app",
  "version": "0.0.0",
  "private": true,
  "description": "SvelteKit Example App",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "main": "build/index.js",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "del .turbo coverage .svelte-kit build *.sarif",
    "codegen": "svelte-kit sync",
    "dev": "vite dev",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1"
  },
  "devDependencies": {
    "@packages/ui-lib-svelte": "workspace:*",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/load-config": "0.2.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@toolchain/eslint": "workspace:*",
    "@toolchain/typescript": "workspace:*",
    "@toolchain/vitest": "workspace:*",
    "effect": "4.0.2",
    "http-status-codes": "2.3.0",
    "mode-watcher": "1.1.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "sveltekit-superforms": "3.0.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.1"
  }
}
