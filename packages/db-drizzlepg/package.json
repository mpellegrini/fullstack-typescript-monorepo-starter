{
  "name": "@packages/db-drizzlepg",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle ORM Database Client and Schema for PostgreSQL",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./client": "./src/client/index.ts",
    "./schema": "./src/schema/index.ts",
    "./helpers": "./src/helpers/index.ts"
  },
  "scripts": {
    "clean": "del .turbo coverage *.sarif",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dbml:generate": "node ./src/generate-dbml.ts",
    "dbml:render": "dbml-renderer -i schema.dbml -o schema.svg",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.0-rc.112",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0-rc.112",
    "pg": "8.23.0",
    "pg-error-enum": "2.0.1",
    "sql-formatter": "15.8.2"
  },
  "devDependencies": {
    "@softwaretechnik/dbml-renderer": "1.0.31",
    "@toolchain/eslint": "workspace:*",
    "@toolchain/typescript": "workspace:*",
    "@toolchain/vitest": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-dbml-generator": "0.10.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc"
  }
}
